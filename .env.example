# Copy to .env.local and fill in. Without the auth + database values the app
# still runs in anonymous mode (compare works, nothing is saved).

# Postgres connection string (Neon, Supabase, or local Docker).
DATABASE_URL=postgres://postgres:dev@localhost:55432/aipasta

# Auth.js secret. Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=

# Required when running `next start` or self-hosting outside Vercel (Vercel
# sets this up automatically). Alternatively set AUTH_URL to your public URL.
# AUTH_TRUST_HOST=true

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Encrypts provider API keys that signed-in users save to their account
# (AES-256-GCM). 32 random bytes, base64. Generate with: openssl rand -base64 32
# Keep it secret and backed up: if it's lost or changed, saved keys can't be
# decrypted and users must re-enter them. Without it, keys stay in the browser.
KEYS_ENCRYPTION_KEY=

# Only while rotating KEYS_ENCRYPTION_KEY (see README): the old key, so saved
# keys keep working until `npm run keys:rotate` re-encrypts them.
# KEYS_ENCRYPTION_KEY_PREVIOUS=

# Rate limiting shared across server instances (https://upstash.com, Redis).
# Strongly recommended in production; without it limits are per process.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional error tracking (https://sentry.io). Server and browser DSNs.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Optional: Qwen region endpoint. Default is Singapore (international).
# QWEN_BASE_URL=https://dashscope-us.aliyuncs.com/compatible-mode/v1
