# Copy to .env.local and fill in. Without the auth + database values the app
# still runs in anonymous mode (compare works, nothing is saved).

# Postgres connection string (Neon, Supabase, or local Docker).
DATABASE_URL=postgres://postgres:dev@localhost:55432/aipasta

# Auth.js secret. Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=

# Required when running `next start` or self-hosting outside Vercel (Vercel
# sets this up automatically). Alternatively set AUTH_URL to your public URL.
# AUTH_TRUST_HOST=true

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: Qwen region endpoint. Default is Singapore (international).
# QWEN_BASE_URL=https://dashscope-us.aliyuncs.com/compatible-mode/v1
